{
  "name": "nano-assistant",
  "version": "0.1.0-beta.1",
  "description": "Nano Assistant — Assistente Virtual Executivo e Inteligente",
  "main": "main.js",
  "author": "Simão Coelho",
  "license": "Apache-2.0",
  "scripts": {
    "build": "electron-builder --win --x64",
    "build:all": "electron-builder --win nsis msi --x64",
    "build:installer": "electron-builder --win msi --x64",
    "dev": "electron . --dev",
    "fetch-electron": "install-electron",
    "icon": "powershell -ExecutionPolicy Bypass -File ../scripts/build_app_icon.ps1",
    "prebuild": "npm run verify:package",
    "prebuild:all": "npm run verify:package",
    "prebuild:installer": "npm run verify:package",
    "start": "electron .",
    "test": "node test/run.js",
    "verify:package": "node scripts/verify-package-inputs.js"
  },
  "build": {
    "appId": "com.nano.assistant",
    "productName": "Nano Assistant",
    "asar": true,
    "copyright": "© 2026 Simão Coelho",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "overlay/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "../core",
        "to": "app/core",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      },
      {
        "from": "../plugins",
        "to": "app/plugins",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      },
      {
        "from": "../config",
        "to": "app/config",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      },
      {
        "from": "../frontend/out",
        "to": "app/frontend/out",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../runtime/python",
        "to": "app/runtime/python",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo"
        ]
      },
      {
        "from": "../version.json",
        "to": "app/version.json"
      },
      {
        "from": "../LICENSE",
        "to": "app/LICENSE"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "app/THIRD_PARTY_NOTICES.md"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "msi",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nano Assistant",
      "runAfterFinish": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "artifactName": "Nano-Setup-${version}-${arch}.${ext}"
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "upgradeCode": "{B7A1E6A8-8B1B-4E5B-9A13-4B9C5D5E6F71}",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "runAfterFinish": true,
      "artifactName": "Nano-Setup-${version}-${arch}.${ext}",
      "warningsAsErrors": true
    }
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.16.1"
  }
}
