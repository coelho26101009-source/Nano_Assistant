{
  "name": "nano-assistant",
  "version": "8.1.0",
  "description": "Nano Assistant — Assistente Virtual Executivo e Inteligente",
  "main": "main.js",
  "author": "Simão Coelho",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:installer": "electron-builder --win msi --x64",
    "build:all": "electron-builder --win nsis msi --x64"
  },
  "build": {
    "appId": "com.nano.assistant",
    "productName": "Nano Assistant",
    "copyright": "© 2026 Simão Coelho",
    "directories": { "output": "../dist-electron" },
    "files": ["main.js", "preload.js"],
    "extraResources": [
      { "from": "../core", "to": "app/core", "filter": ["**/*"] },
      { "from": "../plugins", "to": "app/plugins", "filter": ["**/*"] },
      { "from": "../config", "to": "app/config", "filter": ["**/*"] },
      { "from": "../frontend/out", "to": "app/frontend/out", "filter": ["**/*"] },
      { "from": "../runtime", "to": "app/runtime", "filter": ["**/*"] }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "msi", "arch": ["x64"] }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nano Assistant",
      "runAfterFinish": true
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "upgradeCode": "{B7A1E6A8-8B1B-4E5B-9A13-4B9C5D5E6F71}",
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "runAfterFinish": true,
      "artifactName": "Nano-Assistant-Setup-${version}.${ext}",
      "warningsAsErrors": true
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  }
}
