{
  "name": "helios-v8",
  "version": "8.0.0",
  "description": "H.E.L.I.O.S. — High-Efficiency Local Intelligence & Operating System",
  "main": "main.js",
  "author": "Simão Coelho",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:installer": "electron-builder --win msi --x64",
    "build:all": "electron-builder --win nsis msi --x64"
  },
  "build": {
    "appId": "com.helios.assistant",
    "productName": "HELIOS",
    "copyright": "© 2026 Simão Coelho",
    "directories": {
      "output": "../dist-electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**"
    ],
    "extraResources": [
      {
        "from": "../core",
        "to": "app/core",
        "filter": ["**/*"]
      },
      {
        "from": "../plugins",
        "to": "app/plugins",
        "filter": ["**/*"]
      },
      {
        "from": "../config",
        "to": "app/config",
        "filter": ["**/*"]
      },
      {
        "from": "../frontend/out",
        "to": "app/frontend/out",
        "filter": ["**/*"]
      },
      {
        "from": "../runtime",
        "to": "app/runtime",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "msi", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/installer-header.bmp",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HELIOS",
      "runAfterFinish": true
    },
    "msi": {
      "oneClick": false,
      "perMachine": false,
      "upgradeCode": "{B7A1E6A8-8B1B-4E5B-9A13-4B9C5D5E6F71}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HELIOS",
      "runAfterFinish": true,
      "artifactName": "HELIOS-Setup-${version}.${ext}",
      "warningsAsErrors": true
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "node-pty": "^1.0.0"
  }
}
