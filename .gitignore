# Secrets — never commit credentials
.env
.env.local
*.pem
*.key

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
venv/
.venv/
env/

# Generated embedded runtime
runtime/python/
runtime/wheels/

# Provider/model benchmark reports. These hold RAW MODEL OUTPUT for the
# user's own prompts, plus latency and token measurements taken against their
# personal free-tier accounts. They are developer measurements, not source, and
# must never be committed. The writer additionally refuses to save a report
# that matches a credential pattern -- see scripts/benchmark_providers.py.
runtime/benchmarks/

# Speech-accuracy benchmark sessions. These hold RAW RECORDINGS OF THE
# USER'S VOICE plus the reports derived from them. They are developer
# measurements of a private human being and must never be committed,
# never be uploaded, and never be staged by accident.
runtime/speech_benchmark/

# User data / databases / logs (runtime-generated, never source)
*.db
*.sqlite3
chroma_db/
data/
memoria/
*.log
logs/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Legacy scratch names. The voice stack no longer writes audio into the
# project: each utterance now gets a unique file in the OS temp directory and
# deletes it afterwards. Writing to one fixed name here is what locked the file
# open and left Nano able to speak only once per launch. Kept so an older
# working copy stays clean; do not reintroduce the pattern.
nano_tts_tmp.mp3
nano_audio_output.wav

# Scratch folder created by background-worker demo tasks
test-nano/

# Node / frontend build output
node_modules/
dist/
out/
.next/
build/

# OS
.DS_Store
Thumbs.db
frontend/tsconfig.tsbuildinfo
